<Window x:Class="XauatSchedule.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:XauatSchedule.Controls"
        Title="XAUAT-Classes" Width="510" Height="748" MinWidth="392" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="Transparent"
        AllowsTransparency="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="RootGrid">
        <!-- ═══ 窗口主体 ═══ -->
        <Border x:Name="Shell" CornerRadius="18" BorderThickness="1"
                Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ── 标题栏（可拖动） ── -->
                <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Margin="0,0,8,0"
                                     Fill="{DynamicResource DataBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="WeekTitle" Style="{StaticResource Body}" FontWeight="SemiBold" Text="第 5 周" />
                            <TextBlock x:Name="WeekRange" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Text="09-28 ~ 10-04" />
                        </StackPanel>
                        <TextBlock x:Name="NextLine" Style="{StaticResource Tiny}" Margin="15,2,0,0"
                                   TextTrimming="CharacterEllipsis" Text="下一节 · 计算中…" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button x:Name="BtnToday" Style="{StaticResource IconButton}" Content="今" ToolTip="回到本周 (Home)"
                                Click="Today_Click" />
                        <Button x:Name="BtnSettings" Style="{StaticResource IconButton}" Content="⚙" ToolTip="设置"
                                Click="Settings_Click" />
                        <Button x:Name="BtnPin" Style="{StaticResource IconButton}" Content="📌" ToolTip="置顶"
                                Click="Pin_Click" />
                        <Button Style="{StaticResource IconButton}" Content="—" ToolTip="收进托盘" Click="Minimize_Click" />
                        <Button Style="{StaticResource IconButton}" Content="✕" ToolTip="退出" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <!-- ── 负载折线导航 ── -->
                <ctrl:LoadChart x:Name="Chart" Grid.Row="1" Margin="6,0,6,0" />

                <!-- ── 星期头 ── -->
                <Grid x:Name="DayHeader" Grid.Row="2" Margin="34,0,6,4" />

                <!-- ── 课表网格 ── -->
                <ctrl:WeekGrid x:Name="WeekView" Grid.Row="3" Margin="6,0,6,0" />
                </Grid>
        </Border>


        <!-- ═══ 课程悬浮框（点击课程出现，移开自然消失） ═══ -->
        <Border x:Name="CourseTip" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                MaxWidth="270" CornerRadius="13" Padding="13,11" BorderThickness="1"
                Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="TipScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="TipShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock x:Name="TipName" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TipRoom" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                <TextBlock x:Name="TipTime" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                <TextBlock x:Name="TipTeacher" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══ 面板层（只有两个：数据来源 / 外观设置；课表本身只读） ═══ -->
        <Grid x:Name="OverlayHost" Visibility="Collapsed">
            <Rectangle x:Name="Scrim" Fill="#000000" Opacity="0" MouseLeftButtonDown="Scrim_Click" />
            <Border x:Name="PanelHost" Width="330" HorizontalAlignment="Right" Margin="0,10,10,10"
                    CornerRadius="16" BorderThickness="1"
                    Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PanelShift" />
                </Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0" Style="{x:Null}">
                    <StackPanel Margin="18,16,18,18">
                        <Grid Margin="0,0,0,14">
                            <TextBlock x:Name="PanelTitle" Style="{StaticResource Title}" />
                            <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right"
                                    Click="Panel_Close" />
                        </Grid>

                        <!-- 设置面板 -->
                        <StackPanel x:Name="PaneSettings" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Tiny}" Text="主题" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                                <Button x:Name="BtnThemeLight" Style="{StaticResource PillButton}" Content="亮色"
                                        Tag="light" Click="Theme_Click" Margin="0,0,8,0" Padding="18,7" />
                                <Button x:Name="BtnThemeDark" Style="{StaticResource PillButton}" Content="暗色"
                                        Tag="dark" Click="Theme_Click" Padding="18,7" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Tiny}" Text="数据" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <Button x:Name="BtnRefresh" Style="{StaticResource PrimaryButton}" Content="刷新课表"
                                        Click="Refresh_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource PillButton}" Content="退出登录" Click="Logout_Click" />
                            </StackPanel>
                            <Border x:Name="RefreshProgressBox" CornerRadius="6" Height="5" Margin="0,4,0,4"
                                    Background="{DynamicResource BorderBrush}" Visibility="Collapsed">
                                <Border x:Name="RefreshProgress" HorizontalAlignment="Left" Width="0" CornerRadius="6"
                                        Background="{DynamicResource DataBrush}" />
                            </Border>
                            <TextBlock x:Name="RefreshStatus" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,2,0,14" Text="" />

                            <TextBlock x:Name="AboutText" Style="{StaticResource Tiny}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- ═══ 首次运行：登录层（抓取成功后不再出现） ═══ -->
        <Grid x:Name="LoginGate" Visibility="Collapsed">
            <Rectangle x:Name="GateScrim" Fill="{DynamicResource BgBrush}" Opacity="0" />
            <Border x:Name="GateCard" Width="330" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="16" BorderThickness="1" Padding="22,20,22,20"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="登录教务系统" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16"
                               Text="第一次使用需要绑定一次账号。程序走统一身份认证抓取本学期课表，密码用 Windows DPAPI 加密后保存在本机，只有这个 Windows 账户能解开。" />
                    <TextBlock Style="{StaticResource Tiny}" Text="学号" />
                    <TextBox x:Name="GateUser" Style="{StaticResource Field}" Margin="0,4,0,10" />
                    <TextBlock Style="{StaticResource Tiny}" Text="密码" />
                    <PasswordBox x:Name="GatePass" Style="{StaticResource FieldPassword}" Margin="0,4,0,10" />
                    <StackPanel x:Name="GateCaptchaBox" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Tiny}" Text="验证码（认证平台要求输入）" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Image x:Name="GateCaptchaImage" Width="104" Height="36" Stretch="Uniform" />
                            <TextBox x:Name="GateCaptcha" Style="{StaticResource Field}" Width="86" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="GateProgressBox" CornerRadius="6" Height="5" Margin="0,2,0,6"
                            Background="{DynamicResource BorderBrush}" Visibility="Collapsed">
                        <Border x:Name="GateProgress" HorizontalAlignment="Left" Width="0" CornerRadius="6"
                                Background="{DynamicResource DataBrush}" />
                    </Border>
                    <TextBlock x:Name="GateStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Border x:Name="GateChallengeBox" Visibility="Collapsed" CornerRadius="10" Padding="12,10"
                            BorderThickness="1" BorderBrush="{DynamicResource DataBrush}"
                            Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Tiny}" Text="需要你手动完成一步" />
                            <TextBlock x:Name="GateChallengeText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PillButton}" Content="在浏览器里打开" Click="Gate_OpenBrowser"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource PillButton}" Content="完成，重试" Click="Gate_Retry" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Content="进入课表" Click="Gate_Submit" Padding="16,8" />

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
